{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "rm": "ask",
      // "rm -fr *": "ask",
      // "rm -rf *": "ask",
      // "rm -f *": "ask",

      // CLDR requirements
      "bash": "ask", "write": "ask", "external_directory": "ask"

    }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_MCP_PAT}"
      }
    }
  },
  "provider": {
    "litellm": {
      "cache": false,
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "https://ai-gateway.cloudops.cloudera.com"
      },
      "models": {
        "us.anthropic.claude-sonnet-4-6": {
            "name": "claude-sonnet-4-6"
        },
        "us.anthropic.claude-opus-4-6-v1" : {
          "name": "claude-opus-4-6"
        },
        "us.anthropic.claude-haiku-4-5-20251001-v1:0": {
          "name": "claude-haiku-4-5"
        },
        "us.anthropic.claude-opus-4-7": {
          "name": "claude-opus-4-7"
        },
        "us.anthropic.claude-opus-4-8": {
          "name": "claude-opus-4-8"
        },
        "azure/cloudops-gpt-4o": {
          "name": "gpt-4o"
        },
        "azure/cloudops-gpt-5.1": {
          "name": "gpt-5.1"
        },
        "azure/gpt-5.2": {
          "name": "gpt-5.2"
        },
        "azure/cloudops-gpt-5.1-codex": {
          "name": "gpt-5.1-codex"
        },
        "azure/gpt-5.2-codex": {
          "name": "gpt-5.2-codex"
        },
        "azure/cloudops-gpt-5.4": {
          "name": "gpt-5.4"
        },
        "gemini-2.0-flash": {
          "name": "gemini-2.0-flash"
        },
        "gemini-2.5-pro": {
          "name": "gemini-2.5-pro"
        },
        "gemini-3.1-flash-lite-preview": {
          "name": "gemini-3.1-flash-lite-preview"
        },
        "gemini-3.1-pro-preview": {
          "name": "gemini-3.1-pro-preview"
        },
        "vertex_ai/gemini-3-flash-preview": {
          "name": "gemini-3-flash-preview"
        }
      }
    }
  }
}
